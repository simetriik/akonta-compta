# Version web d'Akonta : compilation Flutter puis service par nginx.
# Construction (contexte = dossier app/) :
#   docker build -f Dockerfile.web \
#     --build-arg SUPABASE_URL=https://adb.exemple.com \
#     --build-arg SUPABASE_PUBLISHABLE_KEY=<clé publique ANON> -t akonta-web .
# La clé de service ne doit jamais être passée ici.

FROM ghcr.io/cirruslabs/flutter:3.47.4 AS build
WORKDIR /src
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
ARG SUPABASE_URL
ARG SUPABASE_PUBLISHABLE_KEY
RUN test -n "$SUPABASE_URL" && test -n "$SUPABASE_PUBLISHABLE_KEY" \
 && flutter build web --release --no-wasm-dry-run \
      --dart-define=SUPABASE_URL=$SUPABASE_URL \
      --dart-define=SUPABASE_PUBLISHABLE_KEY=$SUPABASE_PUBLISHABLE_KEY

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
