# Clé partagée avec l'Edge Function export-document (générer une valeur aléatoire longue)
AKONTA_SERVICE_KEY=changez-moi
# Nombre maximal de lignes acceptées par document
AKONTA_MAX_ROWS=50000

# Chemin du modèle Excel DGI (.xlsm) rempli par /excel/dgi
AKONTA_DGI_TEMPLATE=../inputs/Modèle DGI-Etats-Financiers-SN.xlsm
